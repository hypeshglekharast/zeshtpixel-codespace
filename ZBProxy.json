{
    "Log": {
        "Level": "info"
    },
    "Services": [
        {
            "Name": "Hypixel-in",
            "Listen": 25565,
            "IPAccess": {
                "Mode": ""
            },
            "Outbound": {}
        }
    ],
    "Router": {
        "DefaultOutbound": "RESET",
        "Rules": [
            {
                "Type": "always",
                "Rewrite": {},
                "Sniff": "minecraft"
            },
            {
                "Type": "ServiceName",
                "Parameter": "Hypixel-in",
                "Rewrite": {
                    "Minecraft": {
                        "Hostname": "mc.hypixel.net",
                        "Port": 25565
                    }
                },
                "Outbound": "Hypixel-out"
            }
        ]
    },
    "Outbounds": [
        {
            "Name": "Hypixel-out",
            "TargetAddress": "mc.hypixel.net",
            "TargetPort": 25565,
            "Minecraft": {
                "OnlineCount": {
                    "Max": 20,
                    "Online": -1,
                    "EnableMaxLimit": false
                },
                "HostnameAccess": {
                    "Mode": ""
                },
                "NameAccess": {
                    "Mode": ""
                },
                "PingMode": "",
                "MotdFavicon": "data:image/png;base64,",
                "MotdDescription": "§6§lWelcome to §c§lZeshtPixel §e§lthe server by §b§lDabbler_"
            },
            "ProxyOptions": {}
        }
    ],
    "Lists": {}
}
